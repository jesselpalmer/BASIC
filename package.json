{
  "name": "node-basic-lang",
  "version": "0.0.10",
  "description": "BASIC interpreter",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "bun ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "bun ./node_modules/eslint/bin/eslint.js . --fix",
    "start": "bun ./bin/basic",
    "test": "bun test",
    "test:package": "bun ./scripts/test-package.ts",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --write . bin/basic",
    "format:check": "bun ./node_modules/prettier/bin/prettier.cjs --check . bin/basic",
    "test:coverage": "bun test --coverage",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test:coverage && bun run test:package"
  },
  "repository": "git+https://github.com/jesselpalmer/BASIC.git",
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "BASIC",
    "BASIC interpreter",
    "BASIC lang",
    "BASIC language"
  ],
  "author": "Jesse Palmer <jesselpalmer@gmail.com> (https://jesselpalmer.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesselpalmer/BASIC/issues"
  },
  "homepage": "https://github.com/jesselpalmer/BASIC#readme",
  "bin": {
    "basic": "./bin/basic"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jesselpalmer"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/__tests__/",
    "docs/",
    "examples/"
  ],
  "types": "./src/index.ts",
  "packageManager": "bun@1.4.4"
}
