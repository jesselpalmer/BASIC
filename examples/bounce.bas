10 REM Bouncing ball: Run to start, Stop or Escape to finish
20 LET X = 160
30 LET Y = 100
40 LET DX = 3
50 LET DY = 2
60 COLOR 14
70 CLS
80 CIRCLE X,Y,6
90 WAIT 16
100 IF X + DX > 313 THEN 140
110 IF X + DX < 6 THEN 140
120 GOTO 150
140 LET DX = -DX
150 IF Y + DY > 193 THEN 190
160 IF Y + DY < 6 THEN 190
170 GOTO 200
190 LET DY = -DY
200 LET X = X + DX
210 LET Y = Y + DY
220 GOTO 70
