10 REM PONG: hold Up/Down on the focused canvas; Escape stops
20 CLS
30 PRINT "PONG - first to 3"
40 PRINT "Press Enter, then click the canvas or Tab to it."
50 PRINT "Hold Up/Down to move. Space serves. Escape stops."
60 INPUT "Press Enter to start"; READY$
100 REM A new match resets both scores, paddles, ball and serve
110 LET SCORE = 0
120 LET COMPUTERSCORE = 0
130 LET PADDLE = 100
140 LET OPPONENT = 100
150 LET SERVE = -4
200 REM Serve toward the player who lost the previous point
210 LET X = 160
220 LET Y = 100
230 LET DX = SERVE
235 LET SERVING = 1
240 LET DY = 2 + INT(RND() * 2)
250 IF RND() < .5 THEN 270
260 GOTO 300
270 LET DY = -DY
300 REM Draw one complete frame before yielding
310 CLS
320 PRINT "PONG - first to 3"
330 PRINT "You: "; SCORE; "  Computer: "; COMPUTERSCORE
340 PRINT "Focus canvas. Hold Up/Down. Space serves. Escape stops."
342 IF SERVING = 0 THEN 350
344 PRINT "Press Space when ready to serve."
350 COLOR 7
360 LINE 0,10,319,10
370 LINE 0,190,319,190
380 COLOR 10
390 LINE 16,PADDLE-18,16,PADDLE+18
400 COLOR 12
410 LINE 303,OPPONENT-18,303,OPPONENT+18
420 COLOR 14
430 CIRCLE X,Y,3
440 WAIT 16
450 REM The player is faster than the computer
460 LET PADDLE = PADDLE + 4 * (KEYDOWN("DOWN") - KEYDOWN("UP"))
470 IF PADDLE < 28 THEN 500
480 IF PADDLE > 172 THEN 520
490 GOTO 550
500 LET PADDLE = 28
510 GOTO 550
520 LET PADDLE = 172
550 REM The computer follows only an approaching ball in its half
560 IF DX < 0 THEN 700
570 IF X < 160 THEN 700
580 IF Y < OPPONENT - 1 THEN 620
590 IF Y > OPPONENT + 1 THEN 640
600 GOTO 660
620 LET OPPONENT = OPPONENT - 1
630 GOTO 660
640 LET OPPONENT = OPPONENT + 1
660 IF OPPONENT < 28 THEN 680
670 IF OPPONENT <= 172 THEN 700
675 LET OPPONENT = 172
677 GOTO 700
680 LET OPPONENT = 28
700 IF SERVING = 0 THEN 710
702 IF KEYDOWN("SPACE") = 0 THEN 300
704 LET SERVING = 0
705 REM Reflect overshoot rather than dropping motion at a wall
710 LET NX = X + DX
720 LET NY = Y + DY
723 REM Keep the original vertical motion for paddle crossing height
725 LET MOTIONY = DY
730 IF NY <= 13 THEN 800
740 IF NY >= 187 THEN 840
750 GOTO 900
800 LET NY = 26 - NY
810 LET DY = -DY
820 GOTO 900
840 LET NY = 374 - NY
850 LET DY = -DY
900 REM The ball uses a radius-three box for paddle end contacts
905 REM Cross the paddle plane once; use height at that crossing
910 IF DX > 0 THEN 1000
920 IF X < 19 THEN 1100
930 IF NX > 19 THEN 1100
940 LET CONTACT = Y + MOTIONY * (19 - X) / DX
942 IF CONTACT >= 13 THEN 946
944 LET CONTACT = 26 - CONTACT
946 IF CONTACT <= 187 THEN 950
948 LET CONTACT = 374 - CONTACT
950 IF CONTACT < PADDLE - 21 THEN 1100
960 IF CONTACT > PADDLE + 21 THEN 1100
970 LET NX = 38 - NX
980 LET DX = 4
985 LET DY = INT((CONTACT - PADDLE) / 7)
990 IF DY <> 0 THEN 1100
995 LET DY = 1
997 GOTO 1100
1000 IF X > 300 THEN 1100
1010 IF NX < 300 THEN 1100
1020 LET CONTACT = Y + MOTIONY * (300 - X) / DX
1022 IF CONTACT >= 13 THEN 1026
1024 LET CONTACT = 26 - CONTACT
1026 IF CONTACT <= 187 THEN 1030
1028 LET CONTACT = 374 - CONTACT
1030 IF CONTACT < OPPONENT - 21 THEN 1100
1040 IF CONTACT > OPPONENT + 21 THEN 1100
1050 LET NX = 600 - NX
1060 LET DX = -4
1100 LET X = NX
1110 LET Y = NY
1120 IF X < -3 THEN 1300
1130 IF X > 322 THEN 1400
1140 GOTO 300
1300 REM One point only, then leave the old ball behind
1310 LET COMPUTERSCORE = COMPUTERSCORE + 1
1320 IF COMPUTERSCORE = 3 THEN 1600
1330 LET SERVE = -4
1340 GOTO 200
1400 LET SCORE = SCORE + 1
1410 IF SCORE = 3 THEN 1500
1420 LET SERVE = 4
1430 GOTO 200
1500 CLS
1510 PRINT "YOU WIN!"
1520 GOTO 1700
1600 CLS
1610 PRINT "COMPUTER WINS"
1700 PRINT "You: "; SCORE; "  Computer: "; COMPUTERSCORE
1710 PRINT "First to 3. Escape or Stop ends the game."
1720 INPUT "Press Enter to restart"; READY$
1730 GOTO 100
