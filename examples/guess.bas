10 LET SECRET = INT(RND() * 100) + 1
20 LET TRIES = 0
30 INPUT "Guess a number from 1 to 100"; GUESS
40 LET TRIES = TRIES + 1
50 IF GUESS < SECRET THEN 100
60 IF GUESS > SECRET THEN 120
70 PRINT "Correct in "; TRIES; " tries!"
80 END
100 PRINT "Too low."
110 GOTO 30
120 PRINT "Too high."
130 GOTO 30
