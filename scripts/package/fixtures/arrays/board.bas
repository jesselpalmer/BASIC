10 DIM B(64)
20 FOR I=1 TO 64
30 B(I)=1
40 NEXT I
50 FOR R=2 TO 5
60 FOR C=2 TO 5
70 B(R*8+C+1)=0
80 NEXT C
90 NEXT R
95 M=0
100 S=0
110 FOR I=1 TO 64
120 S=S+B(I)
130 NEXT I
140 PRINT "pieces:";S
150 INPUT "From";F
160 IF F=0 THEN 400
170 INPUT "To";T
180 IF ABS(INT((F-1)/8)-INT((T-1)/8))<>2 THEN 350
190 IF ABS((F-8*INT((F-1)/8))-(T-8*INT((T-1)/8)))<>2 THEN 350
200 IF B((F+T)/2)=0 THEN 350
210 IF B(F)=0 THEN 350
220 IF B(T)=1 THEN 350
230 B(T)=1
240 B(F)=0
250 B((F+T)/2)=0
260 M=M+1
270 GOTO 100
350 PRINT "illegal"
360 GOTO 100
400 PRINT "moves:";M
410 END
